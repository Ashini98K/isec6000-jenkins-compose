# Copy to .env and adjust. .env is gitignored - never commit real values.
#
# Where the Jenkins UI is published on the host.
#   127.0.0.1 = loopback only, reachable via SSH tunnel. This is the default
#               and the recommended setting: the Jenkins UI is an admin
#               interface, not a public web app.
#   0.0.0.0   = every interface. Only do this behind a TLS reverse proxy and
#               a firewall, and say why in your report.
JENKINS_BIND_ADDRESS=127.0.0.1

# Host port for the Jenkins UI.
JENKINS_PORT=8080

# -----------------------------------------------------------------------------
# NOT stored here: the Docker Hub access token and the Snyk API token.
# Those live in the Jenkins credentials store (Manage Jenkins > Credentials) so
# they are encrypted at rest, masked in console output, and referenced from the
# Jenkinsfile by ID only:
#   dockerhub-credentials  (Username with password - username + ACCESS TOKEN)
#   snyk-api-token         (Secret text)
# -----------------------------------------------------------------------------
